# Copy to .env and fill in. Loaded via: python odx.py --env-file scripts/.env <cmd>
# The two keys are DIFFERENT — see references/api-reference.md.

# Client -> proxy
ODX_PROXY_URL=https://proxy.example.com
ODX_PROXY_KEY=your-proxy-x-api-key

# Proxy -> Odoo (target instance)
ODX_ODOO_URL=https://erp.example.com
ODX_ODOO_DB=prod
ODX_ODOO_USER_ID=2
ODX_ODOO_API_KEY=your-odoo-user-api-key
